# Blindfold BI Environment Configuration
# Copy this file to .env and fill in your actual credentials

# NVIDIA NIM Cloud Inference (Optional: falls back to deterministic local synthesizer if omitted)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Application Settings
APP_NAME=Blindfold BI - Skylark Drones
DEBUG=True
PORT=8000

# Monday.com Integration (Optional: can be configured via UI / Settings)
MONDAY_API_TOKEN=your-monday-api-token-here
MONDAY_DEAL_BOARD_ID=
MONDAY_WORK_ORDER_BOARD_ID=
