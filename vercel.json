{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,docs/**,evals/**,infra/**,scripts/**,.github/**,backend/scripts/**,backend/evals/**,backend/tests/*.py,backend/tests/evals/**,*.png,.venv*/**,node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.py"
    },
    {
      "source": "/readyz",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp",
      "destination": "/api/index.py"
    },
    {
      "source": "/mcp/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/|health$|healthz$|readyz$|docs$|redoc$|openapi\\.json$|mcp|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
